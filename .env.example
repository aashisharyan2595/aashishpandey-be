PORT=4000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS
CLIENT_ORIGIN=http://localhost:3000

# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=

# Where contact-form submissions get emailed to. Required for any email to
# be sent at all — without it, submissions are only stored in MongoDB.
CONTACT_TO_EMAIL=you@example.com

# Preferred sender: Brevo SMTP relay (https://brevo.com, free tier). Sends
# through Brevo's own servers — no DNS changes on your primary domain, only
# a one-click email verification of the sender address in the Brevo
# dashboard (Senders, Domains & Dedicated IPs -> Senders). BREVO_SMTP_USER
# is your Brevo account login email; BREVO_SMTP_KEY is the SMTP key from
# Settings -> SMTP & API -> SMTP (not your Brevo account password).
# BREVO_FROM_EMAIL defaults to BREVO_SMTP_USER if unset — set it separately
# only if you verified a different sender address than your login email.
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_FROM_EMAIL=

# Fallback sender if Brevo isn't configured: Gmail SMTP via nodemailer.
# GMAIL_APP_PASSWORD is a Google Account "App Password"
# (myaccount.google.com/apppasswords) — Google has been restricting these,
# so treat Gmail as a fallback rather than the primary option.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Last-resort fallback if neither Brevo nor Gmail is configured: Resend
# (https://resend.com).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Admin area (/admin on the frontend). No ADMIN_PASSWORD anymore — the first
# person to complete the /admin/login "set up your account" form becomes the
# founding admin (stored, bcrypt-hashed, in MongoDB). Everyone after that
# needs approval (local signup is disabled; only Google sign-in creates new
# pending accounts).
ADMIN_JWT_SECRET=

# Optional but strongly recommended on any publicly reachable deploy (staging,
# production): if set, the one-time "set up your account" screen requires this
# value too, so a stranger who finds /admin/login before you do can't claim
# the founding admin account. Leave blank only for fully local development.
BOOTSTRAP_SECRET=

# Canonical frontend URL, used to build password-reset and OAuth redirect links
APP_URL=http://localhost:3000

# Google OAuth (sign-in with Google for /admin). Create credentials at
# https://console.cloud.google.com/apis/credentials — OAuth client type
# "Web application", authorized redirect URI = GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/admin/auth/google/callback

# Cloudinary (media library image uploads, https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Staging -> production content sync. The entire admin CMS (login, bootstrap,
# CRUD — everything under /api/admin except /api/admin/sync/*) 404s whenever
# DEPLOY_ENV=production, so production is never reachable as a CMS at all.
# Set DEPLOY_ENV=production on the Production Render service only; leave it
# unset (defaults to "staging") everywhere else.
DEPLOY_ENV=staging

# Shared secret for the sync receiver (service-to-service auth, not a user
# session) — set to the SAME value on both the Staging and Production Render
# services.
CONTENT_SYNC_SECRET=

# Only set on the Staging service: base URL of the production backend that
# staging pushes/syncs content to, e.g. https://aashishpandey-be.onrender.com
PRODUCTION_API_URL=
